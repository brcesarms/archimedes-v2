# ==============================================================================
# 🏛️ Archimedes V2 — .gitignore Oficial
# ==============================================================================

# IDEs
.vscode/
.idea/
*.code-workspace

# Ambientes virtuais e dependências
.venv/
venv/
env/
node_modules/
.npm/
.bun/

# Caches de interpretadores e compiladores
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Banco de dados e caches de IA locais
.claude-mem/
.cache/
*.db-shm
*.db-wal

# Arquivos de segredos e credenciais (NUNCA commitados)
.env
.env.*
docker/.env
*.key
*.pem
*.pfx
*.pkcs12
id_rsa*
id_ed25519*
*token*
!scripts/metricas-tokens.sh
!docs/arquitetura/adr-002-local-first-tokens.md
password*

# Temporários e logs
*.log
*.bak
*.tmp
*.swp
*~
.DS_Store
Thumbs.db
docker/.env

# Builds e cobertura
dist/
build/
.coverage
htmlcov/
