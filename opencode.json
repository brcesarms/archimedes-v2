{
  "$schema": "https://opencode.ai/config.schema.json",
  "version": "2.0.0 (2026-09-16)",
  "project": "archimedes-v2",
  "description": "Sistema Archimedes V2 — Automação, Infraestrutura e Conhecimento com Padrões de Indústria",
  "author": "Bruno César Medeiros Siqueira",
  "email": "brcesarms@github.com",
  "plugin": [
    "opencode-planning-with-files"
  ],
  "skills": {
    "paths": [
      "./.agents/skills"
    ],
    "auto-reload": true
  },
  "agent": {
    "build": {
      "description": "Assistente principal de infraestrutura e automação do Archimedes V2",
      "mode": "primary",
      "prompt": "{file:./AGENTS.md}",
      "context_window": 32768,
      "permission": {
        "read": "allow",
        "edit": "ask",
        "bash": {
          "*": "ask",
          "ssh *": "ask",
          "scp *": "ask",
          "rsync *": "ask",
          "cat *": "allow",
          "ls *": "allow",
          "pwd": "allow",
          "find *": "allow",
          "grep *": "allow",
          "diff *": "allow",
          "wc *": "allow",
          "stat *": "allow",
          "head *": "allow",
          "tail *": "allow",
          "cmp *": "allow",
          "sha256sum *": "allow",
          "md5sum *": "allow",
          "du *": "allow",
          "bash -n *": "allow",
          "chmod *": "allow",
          "lychee *": "allow",
          "shellcheck *": "allow",
          "shfmt *": "allow",
          "gitleaks *": "allow",
          "restic *": "allow",
          "chezmoi *": "allow",
          "pyinfra *": "allow",
          "rag *": "allow",
          "./scripts/*": "allow",
          "rm *": "ask"
        },
        "task": "allow",
        "glob": "allow",
        "grep": "allow",
        "list": "allow",
        "webfetch": "allow",
        "websearch": "allow",
        "skill": "allow"
      }
    },
    "estudante": {
      "description": "Especialista em estudos para concursos. Cria resumos, flashcards e questões de revisão a partir das notas do cofre. Foco em língua portuguesa, informática, legislação, saúde pública e administração.",
      "mode": "subagent",
      "temperature": 0.4,
      "context_window": 16384,
      "max_tokens": 4096
    },
    "resumidor": {
      "description": "Especialista em transformar conteúdo longo em notas atômicas resumidas. Lê textos extensos e gera notas concisas com padrões de qualidade. Nunca altera o original.",
      "mode": "subagent",
      "temperature": 0.3,
      "context_window": 16384,
      "max_tokens": 4096
    },
    "auditor": {
      "description": "Especialista em auditoria e conformidade técnica do cofre Archimedes V2. Valida links, linters, segurança e integridade de backups.",
      "mode": "subagent",
      "temperature": 0.2,
      "context_window": 16384,
      "max_tokens": 2048
    }
  },
  "options": {
    "verbose": false,
    "color": true,
    "log_level": "info",
    "max_retries": 3,
    "retry_delay": 1000
  }
}
